@host = https://localhost:7144
# Paste tokens and restaurant ID from the responses below. Do not commit real tokens.
@accessToken = REPLACE_WITH_ACCESS_TOKEN
@refreshToken = REPLACE_WITH_REFRESH_TOKEN
@restaurantId = REPLACE_WITH_RESTAURANT_ID
@itemId = REPLACE_WITH_MENU_ITEM_ID

### Register a customer/owner account
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "owner@example.com",
  "password": "LocalDevelopment!12345"
}

### Log in and copy accessToken and refreshToken from the response
POST {{host}}/api/auth/login?useCookies=false
Content-Type: application/json

{
  "email": "owner@example.com",
  "password": "LocalDevelopment!12345"
}

### Read the signed-in account
GET {{host}}/api/account
Authorization: Bearer {{accessToken}}

### Create a restaurant (starts closed)
POST {{host}}/api/owner/restaurants
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Local Kitchen",
  "description": "Puerto Rican food for pickup",
  "phoneNumber": "787-555-0123",
  "address": {
    "addressLine1": "123 Main Street",
    "addressLine2": null,
    "city": "Vega Baja",
    "stateOrTerritory": "Puerto Rico",
    "postalCode": "00693",
    "country": "US"
  }
}

### List your restaurants
GET {{host}}/api/owner/restaurants
Authorization: Bearer {{accessToken}}

### Read your restaurant
GET {{host}}/api/owner/restaurants/{{restaurantId}}
Authorization: Bearer {{accessToken}}

### Open your restaurant
PUT {{host}}/api/owner/restaurants/{{restaurantId}}/availability
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "isOpen": true
}

### Renew your tokens
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Add a dish (copy its ID from the response)
POST {{host}}/api/owner/restaurants/{{restaurantId}}/menu-items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Mofongo con pollo",
  "price": 14.50
}

### List your menu
GET {{host}}/api/owner/restaurants/{{restaurantId}}/menu-items?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### Edit a dish
PUT {{host}}/api/owner/restaurants/{{restaurantId}}/menu-items/{{itemId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Mofongo con pollo",
  "price": 15.00
}

### Mark a dish sold out
PUT {{host}}/api/owner/restaurants/{{restaurantId}}/menu-items/{{itemId}}/availability
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "isAvailable": false
}

### Browse public restaurants (no login needed)
GET {{host}}/api/restaurants?page=1&pageSize=20

### Find open restaurants in Vega Baja
GET {{host}}/api/restaurants?city=Vega%20Baja&isOpen=true

### View a public restaurant
GET {{host}}/api/restaurants/{{restaurantId}}

### View its public menu
GET {{host}}/api/restaurants/{{restaurantId}}/menu?page=1&pageSize=20

### Remove a dish from the menu
DELETE {{host}}/api/owner/restaurants/{{restaurantId}}/menu-items/{{itemId}}
Authorization: Bearer {{accessToken}}
